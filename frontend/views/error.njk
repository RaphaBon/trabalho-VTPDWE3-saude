<!--views/error.njk -->

{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-danger fw-semibold mb-2">Erro {{ error.status or 500 }}</p>
    <h1 class="h3 fw-bold mb-2">{{ message }}</h1>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      {% if error.stack %}
        <pre class="mb-3">{{ error.stack }}</pre>
      {% endif %}
      <a class="btn btn-primary" href="/home">Voltar ao painel</a>
    </div>
  </div>
{% endblock %}
