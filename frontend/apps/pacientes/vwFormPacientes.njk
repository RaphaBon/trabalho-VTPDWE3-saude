{# Formulário de pacientes (incluir, ver, atualizar, remover). #}
{% extends "layout.njk" %}


{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <header class="page-header">
    <p class="page-kicker text-primary fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Formulario de pacientes</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos pacientes.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Dados do paciente</h2>
          <p class="text-secondary mb-0">Informe os dados para inserir, atualizar ou remover um paciente.</p>
        </div>
      </div>

      <form id="frmPacientes" data-servidor-dw3="{{ servidorDw3 }}">
        {# ID e removido ficam ocultos. #}
        <input type="hidden" id="pacienteid" name="pacienteid" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="telefone" class="form-label">Telefone</label>
            <input type="text" class="form-control" id="telefone" name="telefone" value="" required>
          </div>

          <div class="col-12 col-md-3">
            <label for="cpf" class="form-label">CPF</label>
            <input type="text" class="form-control" id="cpf" name="cpf" value="" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="peso" class="form-label">Peso (kg)</label>
            <input type="number" class="form-control" id="peso" name="peso" min="0" step="0.01" value="" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="datanascimento" class="form-label">Data de Nascimento</label>
            <input type="date" class="form-control" id="datanascimento" name="datanascimento" value="" required>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          {# O JS mostra só o botão da operação atual. #}
          <button type="button" class="btn btn-primary d-none" id="btnInserirPaciente">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPaciente" disabled>
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPaciente">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/pacientes" id="btnFecharPaciente">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/pacientes/vwFormPacientes.js"></script>
{% endblock %}
